{
  "buildCommand": "npm run optimize:images && vite build",
  "outputDirectory": "dist",
  "framework": null,
  "redirects": [
    {
      "source": "/services",
      "destination": "/accommodation",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "destination": "/gallery",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
